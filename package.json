{
  "name": "security-txt-parser",
  "version": "1.0.0",
  "description": "Parse, validate, and serialize RFC 9116 security.txt files in TypeScript.",
  "author": "Ivan Podgurskiy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-podgurskiy/security-txt-parser.git"
  },
  "homepage": "https://github.com/ivan-podgurskiy/security-txt-parser#readme",
  "bugs": {
    "url": "https://github.com/ivan-podgurskiy/security-txt-parser/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "security.txt",
    "security-txt",
    "rfc9116",
    "vulnerability",
    "disclosure",
    "parser",
    "validator",
    "well-known"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --minify",
    "conformance:check": "node scripts/check-conformance-hash.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
